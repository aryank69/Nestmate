# Supavisor transaction pooler (port 6543) for application and seed traffic.
DATABASE_URL="postgresql://postgres.PROJECT_REF:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&uselibpqcompat=true&sslmode=require"

# Maximum node-postgres connections per application process. Start at 1 for Supavisor transaction mode.
DATABASE_POOL_MAX="1"

# Supavisor session pooler (port 5432) for Prisma migrations and admin commands.
DIRECT_URL="postgresql://postgres.PROJECT_REF:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:5432/postgres?uselibpqcompat=true&sslmode=require"

# Password for the least-privilege runtime role; injected into DATABASE_URL.
DATABASE_PASSWORD="REPLACE_ME"

# Administrative database password; used only with DIRECT_URL for migrations.
DIRECT_DATABASE_PASSWORD="REPLACE_ME"

# Public API values used by the Supabase browser SDK.
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_REPLACE_ME"

# Local app origin; replace with the deployed HTTPS origin in production.
NEXT_PUBLIC_SITE_URL="http://localhost:3002"

# Listings not reconfirmed within this many days are shown as stale.
LISTING_STALE_AFTER_DAYS="30"
