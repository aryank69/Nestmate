  FIND_ROOMMATE
  LIST_PROPERTY
  POST_REQUIREMENT
}

model User {
  id                             String                                 @id @default(cuid())
  authUserId                     String                                 @unique @db.Uuid
  name                           String
  email                          String?                                @unique
  dateOfBirth                    DateTime?                              @db.Date
  profession                     String?
  companyOrCollege               String?
  bio                            String?                                @db.VarChar(500)
  createdAt                      DateTime                               @default(now())
  updatedAt                      DateTime                               @updatedAt
  memberships                    CommunityMember[]
  posts                          Post[]
  preferences                    UserPreferences?
  conversationsAsParticipantOne  Conversation[]                         @relation("ConversationParticipantOne")
  conversationsAsParticipantTwo  Conversation[]                         @relation("ConversationParticipantTwo")
  sentMessages                   Message[]
  sentCommunityMessages          CommunityMessage[]
  blocksCreated                  UserBlock[]                            @relation("UserBlockBlocker")
  blocksReceived                 UserBlock[]                            @relation("UserBlockBlocked")
  reportsSubmitted               Report[]                               @relation("ReportReporter")
  notificationsReceived          Notification[]                         @relation("NotificationRecipient")
  notificationsCreated           Notification[]                         @relation("NotificationActor")
  savedPosts                     SavedPost[]
  savedSearches                  SavedSearch[]
  shortlistsCreated              ShortlistedProfile[]                   @relation("ProfileShortlistOwner")
  shortlistedBy                  ShortlistedProfile[]                   @relation("ProfileShortlistTarget")
  recentViews                    RecentView[]                           @relation("RecentViewViewer")
  profileViews                   RecentView[]                           @relation("RecentViewTargetUser")
  visitsRequested                VisitRequest[]                         @relation("VisitRequester")
  visitsOwned                    VisitRequest[]                         @relation("VisitOwner")
  visitOutcomes                  VisitOutcome[]
  visitAvailabilityRules         VisitAvailabilityRule[]
  visitAvailabilityBlocks        VisitAvailabilityBlock[]
  visitSlotPreferences           VisitSlotPreference[]
  visitAttendances               VisitAttendance[]
  visitFeedback                  VisitFeedback[]
  listingRealityFeedback         ListingRealityFeedback[]
  verificationChecks             VerificationCheck[]
  safetyActivities               SafetyActivity[]
  safetyFlags                    SafetyFlag[]
  moderatorMembership            ModeratorMembership?
  moderationState                UserModerationState?                   @relation("ModeratedUser")
  moderationStateUpdates         UserModerationState[]                  @relation("ModerationStateUpdater")
  moderationReviews              ModerationReview[]
  moderationActions              ModerationAuditLog[]                   @relation("ModeratorAudit")
  moderationActionsReceived      ModerationAuditLog[]                   @relation("ModerationSubject")
  supportCases                   SupportCase[]
  supportMessages                SupportCaseMessage[]
  supportNotes                   SupportCaseInternalNote[]
  interestsTracked               InterestActivity[]                     @relation("InterestActivityOwner")
  interestFrom                   InterestActivity[]                     @relation("InterestActivityTargetUser")
  reminders                      Reminder[]
  moveInChecklistsOwned          MoveInChecklist[]                      @relation("MoveInChecklistOwner")
  moveInChecklistsAsTarget       MoveInChecklist[]                      @relation("MoveInChecklistTargetUser")
  documentSpacesAsParticipantOne FinalizedDocumentSpace[]               @relation("DocumentSpaceParticipantOne")
  documentSpacesAsParticipantTwo FinalizedDocumentSpace[]               @relation("DocumentSpaceParticipantTwo")
  documentSpacesAsFlatmateTarget FinalizedDocumentSpace[]               @relation("DocumentSpaceFlatmateTarget")
  sharedDocuments                SharedDocument[]                       @relation("SharedDocumentUploader")
  documentAcknowledgements       SharedDocumentAcknowledgement[]
  finalizedMilestones            FinalizedMatchMilestone[]
  documentSpacesClosed           FinalizedDocumentSpace[]               @relation("DocumentSpaceClosedBy")
  finalizedMatchStatusChanges    FinalizedMatchStatusChange[]           @relation("FinalizedMatchStatusActor")
  householdMemberships           HouseholdMember[]
  householdsArchived             Household[]                            @relation("HouseholdArchivedBy")
  householdItemsCreated          HouseholdItem[]                        @relation("HouseholdItemCreator")
  householdItemsAssigned         HouseholdItem[]                        @relation("HouseholdItemAssignee")
  householdExpensesCreated       HouseholdExpense[]                     @relation("HouseholdExpenseCreator")
  householdExpensesPaid          HouseholdExpense[]                     @relation("HouseholdExpensePayer")
  householdExpenseShares         HouseholdExpenseShare[]                @relation("HouseholdExpenseShareMember")
  householdExpenseCredits        HouseholdExpenseShare[]                @relation("HouseholdExpenseShareCreditor")
  householdSettlementsFrom       HouseholdSettlement[]                  @relation("HouseholdSettlementFrom")
  householdSettlementsTo         HouseholdSettlement[]                  @relation("HouseholdSettlementTo")
  householdSettlementsRecorded   HouseholdSettlement[]                  @relation("HouseholdSettlementRecorder")
  householdSettlementsConfirmed  HouseholdSettlement[]                  @relation("HouseholdSettlementConfirmer")
  householdRecurringCreated      HouseholdRecurringExpenseTemplate[]    @relation("HouseholdRecurringCreator")
  householdRecurringPaid         HouseholdRecurringExpenseTemplate[]    @relation("HouseholdRecurringPayer")
  householdRecurringParticipants HouseholdRecurringExpenseParticipant[]
  householdBudgetsCreated        HouseholdMonthlyBudget[]               @relation("HouseholdBudgetCreator")
  householdBudgetsUpdated        HouseholdMonthlyBudget[]               @relation("HouseholdBudgetUpdater")
  searchTeamsOwned               SearchTeam[]                           @relation("SearchTeamOwner")
  searchTeamMemberships          SearchTeamMember[]
  searchTeamInvitesSent          SearchTeamInvite[]                     @relation("SearchTeamInviteSender")
  searchTeamInvitesReceived      SearchTeamInvite[]                     @relation("SearchTeamInviteRecipient")
  searchTeamListingsAdded        SearchTeamListing[]
  searchTeamVotes                SearchTeamVote[]
  searchTeamComments             SearchTeamComment[]
  searchTeamVisitsShared         SearchTeamVisit[]

  @@index([name])
  @@index([createdAt(sort: Desc)])
}

model Conversation {
  id                       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  participantOneId         String
  participantTwoId         String
  participantOneLastReadAt DateTime? @db.Timestamptz(3)
  participantTwoLastReadAt DateTime? @db.Timestamptz(3)
  lastMessageAt            DateTime? @db.Timestamptz(3)
  createdAt                DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime  @updatedAt @db.Timestamptz(3)
  participantOne           User      @relation("ConversationParticipantOne", fields: [participantOneId], references: [id], onDelete: Cascade)
  participantTwo           User      @relation("ConversationParticipantTwo", fields: [participantTwoId], references: [id], onDelete: Cascade)
  messages                 Message[]

  @@unique([participantOneId, participantTwoId])
  @@index([participantOneId, lastMessageAt(sort: Desc)])
  @@index([participantTwoId, lastMessageAt(sort: Desc)])
}

model Message {
  id               String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId   String                  @db.Uuid
  senderId         String
  body             String                  @db.VarChar(2000)
  moderationStatus ContentModerationStatus @default(VISIBLE)
  createdAt        DateTime                @default(now()) @db.Timestamptz(3)
  conversation     Conversation            @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender           User                    @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt, id])
  @@index([senderId])
  @@index([moderationStatus, conversationId, createdAt])
}

model City {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  state       String
  countryCode String     @default("IN") @db.Char(2)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  localities  Locality[]

  @@unique([name, state, countryCode])
  @@index([state])
}

model Locality {
  id          String                  @id @default(cuid())
  name        String
  slug        String
  cityId      String
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  city        City                    @relation(fields: [cityId], references: [id], onDelete: Restrict)
  community   Community?
  preferredBy UserPreferredLocality[]

  @@unique([cityId, slug])
  @@index([cityId, name])
}

model Community {
  id          String             @id @default(cuid())
  name        String
  slug        String             @unique
  description String?            @db.VarChar(500)
  isActive    Boolean            @default(true)
  localityId  String             @unique
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  locality    Locality           @relation(fields: [localityId], references: [id], onDelete: Cascade)
  members     CommunityMember[]
  posts       Post[]
  messages    CommunityMessage[]

  @@index([isActive])
}

model CommunityMember {
  userId         String
  communityId    String
  role           CommunityRole @default(MEMBER)
  joinedAt       DateTime      @default(now())
  lastChatReadAt DateTime?     @db.Timestamptz(3)
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  community      Community     @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@id([userId, communityId])
  @@index([communityId, joinedAt])
}

model CommunityMessage {
  id               String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  communityId      String
  senderId         String
  replyToId        String?                 @db.Uuid
  body             String                  @db.VarChar(2000)
  moderationStatus ContentModerationStatus @default(VISIBLE)
  createdAt        DateTime                @default(now()) @db.Timestamptz(3)
  community        Community               @relation(fields: [communityId], references: [id], onDelete: Cascade)
  sender           User                    @relation(fields: [senderId], references: [id], onDelete: Cascade)
  replyTo          CommunityMessage?       @relation("CommunityMessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies          CommunityMessage[]      @relation("CommunityMessageReplies")

  @@index([communityId, createdAt, id])
  @@index([senderId])
  @@index([replyToId])
  @@index([moderationStatus, communityId, createdAt])
}

model Post {
  id                 String                    @id @default(cuid())
  type               PostType
  status             PostStatus                @default(ACTIVE)
  availabilityStatus ListingAvailabilityStatus @default(AVAILABLE)
  title              String                    @db.VarChar(140)
  description        String                    @db.VarChar(2000)
  monthlyAmountMin   Int?
  monthlyAmountMax   Int?
  securityDeposit    Int?
  maintenanceAmount  Int?
  currency           String                    @default("INR") @db.Char(3)
  moveInDate         DateTime?                 @db.Date
  genderPreference   GenderPreference          @default(ANY)
  propertyType       PropertyType?
  roomType           RoomType?
  furnishingStatus   FurnishingStatus?
  preferredOccupant  PreferredOccupant?
  attachedBathroom   Boolean?
  parkingType        ParkingType?
  latitude           Decimal?                  @db.Decimal(9, 6)
  longitude          Decimal?                  @db.Decimal(9, 6)
  locationPrecision  LocationPrecision?
  bedrooms           Int?
  bathrooms          Int?
  currentOccupants   Int?
  availableSpots     Int?
  mealsIncluded      Boolean?
  amenities          String[]                  @default([])
  tags               String[]                  @default([])
  imagePaths         String[]                  @default([])
  authorId           String
  communityId        String
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  publishedAt        DateTime?
  lastConfirmedAt    DateTime                  @default(now()) @db.Timestamptz(3)
  moderationStatus   ContentModerationStatus   @default(VISIBLE)
  author             User                      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  community          Community                 @relation(fields: [communityId], references: [id], onDelete: Cascade)
  savedBy            SavedPost[]
  recentViews        RecentView[]
  visitRequests      VisitRequest[]
  verificationChecks VerificationCheck[]
  interestActivity   InterestActivity[]
  moveInChecklists   MoveInChecklist[]
  documentSpaces     FinalizedDocumentSpace[]
  realityFeedback    ListingRealityFeedback[]
  searchTeamListings SearchTeamListing[]

  @@index([authorId, createdAt])
  @@index([communityId, type, status, createdAt])
  @@index([communityId, status, publishedAt(sort: Desc), id])
  @@index([communityId, status, availabilityStatus, lastConfirmedAt(sort: Desc)])
  @@index([communityId, status, genderPreference])
  @@index([communityId, status, monthlyAmountMin])
  @@index([communityId, status, monthlyAmountMax])
  @@index([communityId, status, moveInDate])
  @@index([communityId, latitude, longitude])
  @@index([moveInDate])
  @@index([moderationStatus, status, publishedAt(sort: Desc)])
}

model VisitRequest {
  id               String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  postId           String
  requesterId      String
  ownerId          String
  status           VisitRequestStatus      @default(PENDING)
  calendarRevision Int                     @default(0)
  requestedAt      DateTime                @db.Timestamptz(3)
  proposedAt       DateTime?               @db.Timestamptz(3)
  scheduledAt      DateTime?               @db.Timestamptz(3)
  note             String?                 @db.VarChar(500)
  respondedAt      DateTime?               @db.Timestamptz(3)
  createdAt        DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime                @updatedAt @db.Timestamptz(3)
  post             Post                    @relation(fields: [postId], references: [id], onDelete: Cascade)
  requester        User                    @relation("VisitRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  owner            User                    @relation("VisitOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  outcomes         VisitOutcome[]
  changes          VisitChange[]
  slotPreference   VisitSlotPreference?
  attendances      VisitAttendance[]
  feedback         VisitFeedback[]
  realityFeedback  ListingRealityFeedback?
  searchTeamVisits SearchTeamVisit[]
  moveInChecklists MoveInChecklist[]

  @@index([requesterId, requestedAt(sort: Desc)])
  @@index([ownerId, requestedAt(sort: Desc)])
  @@index([ownerId, status, scheduledAt])
  @@index([postId, status, requestedAt])
}

model VisitAvailabilityRule {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId     String
  weekday     Int
  startMinute Int
  endMinute   Int
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([ownerId, weekday])
  @@index([ownerId, weekday])
}

model VisitAvailabilityBlock {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId   String
  startsAt  DateTime @db.Timestamptz(3)
  endsAt    DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, startsAt, endsAt])
}

model VisitSlotPreference {
  id                   String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  visitId              String       @unique @db.Uuid
  requesterId          String
  preferredWeekdays    Int[]        @default([])
  preferredStartMinute Int?
  preferredEndMinute   Int?
  createdAt            DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime     @updatedAt @db.Timestamptz(3)
  visit                VisitRequest @relation(fields: [visitId], references: [id], onDelete: Cascade)
  requester            User         @relation(fields: [requesterId], references: [id], onDelete: Cascade)

  @@index([requesterId, updatedAt(sort: Desc)])
}

model VisitChange {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  visitId        String       @db.Uuid
  revision       Int
  actorRole      String       @db.VarChar(16)
  previousStatus String       @db.VarChar(16)
  status         String       @db.VarChar(16)
  previousTime   DateTime?    @db.Timestamptz(3)
  scheduledAt    DateTime?    @db.Timestamptz(3)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  visit          VisitRequest @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@unique([visitId, revision])
}

model VisitOutcome {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  visitId     String           @db.Uuid
  userId      String
  outcome     VisitOutcomeType
  privateNote String?          @db.VarChar(500)
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(3)
  visit       VisitRequest     @relation(fields: [visitId], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([visitId, userId])
  @@index([userId, outcome, updatedAt(sort: Desc)])
}

model VisitAttendance {
  id           String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  visitId      String                       @db.Uuid
  userId       String
  checkedInAt  DateTime?                    @db.Timestamptz(3)
  confirmation VisitAttendanceConfirmation?
  confirmedAt  DateTime?                    @db.Timestamptz(3)
  createdAt    DateTime                     @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime                     @updatedAt @db.Timestamptz(3)
  visit        VisitRequest                 @relation(fields: [visitId], references: [id], onDelete: Cascade)
  user         User                         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([visitId, userId])
  @@index([userId, updatedAt(sort: Desc)])
}

model VisitFeedback {
  id                   String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  visitId              String       @db.Uuid
  userId               String
  propertyAccuracy     Int          @db.SmallInt
  cleanliness          Int          @db.SmallInt
  communicationQuality Int          @db.SmallInt
  safetyComfort        Int          @db.SmallInt
  overallExperience    Int          @db.SmallInt
  privateNote          String?      @db.VarChar(1000)
