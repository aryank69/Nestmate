  generatedExpenses HouseholdExpense[]

  @@index([householdId, status, firstDueDate])
  @@index([paidById, status, updatedAt(sort: Desc)])
  @@index([createdById, updatedAt(sort: Desc)])
}

model HouseholdRecurringExpenseParticipant {
  id                String                            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  templateId        String                            @db.Uuid
  memberId          String
  customAmountMinor Int?
  createdAt         DateTime                          @default(now()) @db.Timestamptz(3)
  template          HouseholdRecurringExpenseTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  member            User                              @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([templateId, memberId])
  @@index([memberId, createdAt(sort: Desc)])
}

model HouseholdMonthlyBudget {
  id          String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  householdId String                  @db.Uuid
  month       DateTime                @db.Date
  category    HouseholdBudgetCategory
  amountMinor Int
  createdById String
  updatedById String
  createdAt   DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime                @updatedAt @db.Timestamptz(3)
  household   Household               @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdBy   User                    @relation("HouseholdBudgetCreator", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy   User                    @relation("HouseholdBudgetUpdater", fields: [updatedById], references: [id], onDelete: Restrict)

  @@unique([householdId, month, category])
  @@index([householdId, month])
  @@index([createdById, updatedAt(sort: Desc)])
  @@index([updatedById, updatedAt(sort: Desc)])
}

model Reminder {
  id              String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String
  reminderKey     String             @db.VarChar(240)
  kind            ReminderKind
  targetType      ReminderTargetType
  targetId        String             @db.VarChar(128)
  title           String             @db.VarChar(140)
  description     String?            @db.VarChar(300)
  href            String             @db.VarChar(500)
  dueAt           DateTime           @db.Timestamptz(3)
  sourceUpdatedAt DateTime           @db.Timestamptz(3)
  snoozedUntil    DateTime?          @db.Timestamptz(3)
  dismissedAt     DateTime?          @db.Timestamptz(3)
  inactiveAt      DateTime?          @db.Timestamptz(3)
  createdAt       DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime           @updatedAt @db.Timestamptz(3)
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, reminderKey])
  @@index([userId, inactiveAt, dismissedAt, snoozedUntil, dueAt])
  @@index([userId, kind, updatedAt(sort: Desc)])
}

model RecentView {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  viewerId     String
  postId       String?
  viewedUserId String?
  viewedAt     DateTime @default(now()) @db.Timestamptz(3)
  viewer       User     @relation("RecentViewViewer", fields: [viewerId], references: [id], onDelete: Cascade)
  post         Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  viewedUser   User?    @relation("RecentViewTargetUser", fields: [viewedUserId], references: [id], onDelete: Cascade)

  @@unique([viewerId, postId])
  @@unique([viewerId, viewedUserId])
  @@index([viewerId, viewedAt(sort: Desc)])
  @@index([postId])
  @@index([viewedUserId])
}

model UserPreferences {
  id                    String                  @id @default(cuid())
  userId                String                  @unique
  budgetMin             Int?
  budgetMax             Int?
  preferredMoveInDate   DateTime?               @db.Date
  diet                  DietPreference?
  smoking               HabitFrequency?
  drinking              HabitFrequency?
  sleepSchedule         SleepSchedule?
  cleanliness           CleanlinessLevel?
  pets                  PetPreference?
  occupationStatus      OccupationStatus?
  commuteDestination    String?                 @db.VarChar(120)
  commuteLatitude       Decimal?                @db.Decimal(9, 6)
  commuteLongitude      Decimal?                @db.Decimal(9, 6)
  preferredCommuteKm    Int?
  onboardingIntent      OnboardingIntent?
  onboardingCompletedAt DateTime?               @db.Timestamptz(3)
  onboardingSkippedAt   DateTime?               @db.Timestamptz(3)
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  user                  User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  preferredLocalities   UserPreferredLocality[]

  @@index([budgetMin, budgetMax])
  @@index([preferredMoveInDate])
  @@index([diet])
  @@index([smoking])
  @@index([drinking])
  @@index([sleepSchedule])
  @@index([cleanliness])
  @@index([pets])
  @@index([occupationStatus])
  @@index([preferredCommuteKm])
}

model UserPreferredLocality {
  preferencesId String
  localityId    String
  priority      Int             @default(0)
  createdAt     DateTime        @default(now())
  preferences   UserPreferences @relation(fields: [preferencesId], references: [id], onDelete: Cascade)
  locality      Locality        @relation(fields: [localityId], references: [id], onDelete: Cascade)

  @@id([preferencesId, localityId])
  @@index([localityId])
  @@index([preferencesId, priority])
}

model UserBlock {
  blockerId String
  blockedId String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  blocker   User     @relation("UserBlockBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("UserBlockBlocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
}

model Report {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reporterId     String
  reportedUserId String
  targetType     ReportTargetType
  targetId       String           @db.VarChar(128)
  reason         ReportReason
  details        String?          @db.VarChar(500)
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)
  reporter       User             @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  safetyFlag     SafetyFlag?

  @@unique([reporterId, targetType, targetId])
  @@index([reporterId, createdAt(sort: Desc)])
  @@index([reportedUserId, createdAt(sort: Desc)])
  @@index([targetType, targetId])
}

model SafetyActivity {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId            String
  scope              SafetyActivityScope
  targetType         ReportTargetType
  targetId           String              @db.VarChar(128)
  contentFingerprint String?             @db.Char(32)
  contactFingerprint String?             @db.Char(32)
  createdAt          DateTime            @default(now()) @db.Timestamptz(3)
  actor              User                @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([actorId, scope, createdAt(sort: Desc)])
  @@index([actorId, contentFingerprint, createdAt(sort: Desc)])
  @@index([actorId, contactFingerprint, createdAt(sort: Desc)])
}

model SafetyFlag {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId         String
  targetType      ReportTargetType
  targetId        String              @db.VarChar(128)
  category        SafetyFlagCategory
  severity        SafetyFlagSeverity  @default(LOW)
  status          SafetyFlagStatus    @default(OPEN)
  scope           SafetyActivityScope
  restrictedUntil DateTime?           @db.Timestamptz(3)
  relatedReportId String?             @unique @db.Uuid
  dedupeKey       String              @unique @db.VarChar(200)
  privateDetails  Json?
  createdAt       DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime            @updatedAt @db.Timestamptz(3)
  actor           User                @relation(fields: [actorId], references: [id], onDelete: Cascade)
  relatedReport   Report?             @relation(fields: [relatedReportId], references: [id], onDelete: SetNull)

  @@index([actorId, status, restrictedUntil])
  @@index([targetType, targetId, status])
  @@index([category, status, createdAt(sort: Desc)])
}

model ModeratorMembership {
  userId              String        @id
  role                ModeratorRole
  grantedByAuthUserId String?       @db.Uuid
  createdAt           DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime      @updatedAt @db.Timestamptz(3)
  user                User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([role, createdAt])
}

model UserModerationState {
  userId          String               @id
  status          UserModerationStatus
  restrictedUntil DateTime?            @db.Timestamptz(3)
  privateReason   String               @db.VarChar(500)
  updatedById     String
  createdAt       DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime             @updatedAt @db.Timestamptz(3)
  user            User                 @relation("ModeratedUser", fields: [userId], references: [id], onDelete: Cascade)
  updatedBy       User                 @relation("ModerationStateUpdater", fields: [updatedById], references: [id], onDelete: Restrict)

  @@index([status, restrictedUntil])
  @@index([updatedById, updatedAt(sort: Desc)])
}

model ModerationReview {
  id           String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  queueType    ModerationQueueType
  queueId      String                 @db.VarChar(128)
  status       ModerationReviewStatus
  reviewedById String
  createdAt    DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime               @updatedAt @db.Timestamptz(3)
  reviewedBy   User                   @relation(fields: [reviewedById], references: [id], onDelete: Restrict)

  @@unique([queueType, queueId])
  @@index([reviewedById, updatedAt(sort: Desc)])
}

model ModerationAuditLog {
  id             String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  moderatorId    String
  action         ModerationActionType
  queueType      ModerationQueueType
  queueId        String               @db.VarChar(128)
  subjectUserId  String
  targetType     String               @db.VarChar(40)
  targetId       String               @db.VarChar(128)
  reason         String               @db.VarChar(500)
  privateDetails Json?
  createdAt      DateTime             @default(now()) @db.Timestamptz(3)
  moderator      User                 @relation("ModeratorAudit", fields: [moderatorId], references: [id], onDelete: Restrict)
  subjectUser    User                 @relation("ModerationSubject", fields: [subjectUserId], references: [id], onDelete: Restrict)

  @@index([moderatorId, createdAt(sort: Desc)])
  @@index([subjectUserId, createdAt(sort: Desc)])
  @@index([queueType, queueId, createdAt(sort: Desc)])
}

model SupportCase {
  id             String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String
  category       SupportCaseCategory
  subject        String                    @db.VarChar(120)
  description    String                    @db.VarChar(2000)
  reference      String?                   @db.VarChar(200)
  status         SupportCaseStatus         @default(OPEN)
  lastResponseAt DateTime?                 @db.Timestamptz(3)
  createdAt      DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime                  @updatedAt @db.Timestamptz(3)
  user           User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages       SupportCaseMessage[]
  internalNotes  SupportCaseInternalNote[]

  @@index([userId, status, updatedAt(sort: Desc)])
  @@index([status, updatedAt(sort: Desc)])
}

model SupportCaseMessage {
  id         String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  caseId     String             @db.Uuid
  senderId   String
  senderRole SupportMessageRole
  body       String             @db.VarChar(2000)
  createdAt  DateTime           @default(now()) @db.Timestamptz(3)
  case       SupportCase        @relation(fields: [caseId], references: [id], onDelete: Cascade)
  sender     User               @relation(fields: [senderId], references: [id], onDelete: Restrict)

  @@index([caseId, createdAt, id])
  @@index([senderId, createdAt(sort: Desc)])
}

model SupportCaseInternalNote {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  caseId      String      @db.Uuid
  moderatorId String
  body        String      @db.VarChar(2000)
  createdAt   DateTime    @default(now()) @db.Timestamptz(3)
  case        SupportCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  moderator   User        @relation(fields: [moderatorId], references: [id], onDelete: Restrict)

  @@index([caseId, createdAt, id])
  @@index([moderatorId, createdAt(sort: Desc)])
}

model Notification {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recipientId String
  actorId     String?
  type        NotificationType
  title       String           @db.VarChar(140)
  body        String?          @db.VarChar(300)
  href        String           @db.VarChar(500)
  resourceId  String           @db.VarChar(128)
  readAt      DateTime?        @db.Timestamptz(3)
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  recipient   User             @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor       User?            @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@unique([recipientId, type, resourceId, actorId])
  @@index([recipientId, readAt, createdAt(sort: Desc)])
  @@index([actorId])
}
